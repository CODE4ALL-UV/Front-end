# Example .env for translation API
# Set provider to "google" to use Google Cloud Translate v2, or "deepl" to use DeepL.
TRANSLATE_PROVIDER=google
# Google Cloud Translate API key (Cloud Translation API enabled)
TRANSLATE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# OR for DeepL:
# TRANSLATE_PROVIDER=deepl
# TRANSLATE_API_KEY=YOUR_DEEPL_API_KEY_HERE
# Example environment variables for Flutter app
# Copy this file to .env and replace the values with your own.

GOOGLE_SERVER_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
BACKEND_URL=http://127.0.0.1:8000
